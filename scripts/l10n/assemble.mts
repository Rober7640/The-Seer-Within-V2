// Stage 8 of funnel-localize: write the final translations into the locale bundle.
//
//   npx tsx scripts/l10n/assemble.mts <run dir> --locale <code> [--final final.json]
//
// Reads <run dir>/segments.jsonl and <run dir>/final.json ({ id: text }, after
// adjudication) and MERGES them into what the locale already ships, so batches add
// up (batch 2 of the tarot landers adds hooks; it never drops batch 1):
//
//   shared/l10n/<locale>/catalog.ts   CATALOG: inline copy, English text → translation
//   shared/l10n/<locale>/data.ts      DATA: data twins as overlays: objects by key, arrays as
//                                     index patches { "0": …, "2": … } (shared/i18n overlay)
//   shared/l10n/<locale>/jsx.ts       JSX_TEXT: copy that holds JSX in English, as tagged
//                                     text ("…<br/><strong>…</strong>"), rendered client-side
//   shared/l10n/<locale>/meta.json    id → srcHash of the English it was made from (drift)
// (.ts, not .json: the repo has no resolveJsonModule, and esbuild/vite inline .ts the same way.)
//
// Every text goes through applyLocaleTypography (no-break spaces, « »). The bundle
// entry points (client/src/l10n/<locale>/index.ts, the server line in
// shared/l10n/serverBundles.ts) are written once by hand and only import these files.
import fs from "node:fs";
import path from "node:path";
import type { Segment } from "./extract.mts";
import { applyLocaleTypography } from "../../shared/typography";
import type { LocaleCode } from "../../shared/locales";

const args = process.argv.slice(2);
const arg = (k: string, d?: string) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : d; };
const VALUE_FLAGS = new Set(["--locale", "--final"]);
const dir = args.find((a, i) => !a.startsWith("--") && !VALUE_FLAGS.has(args[i - 1]));
if (!dir) throw new Error("usage: assemble.mts <run dir> --locale <code> [--final final.json]");
if (!arg("--locale")) throw new Error("--locale <code> is required (fr-FR, es-US, …)");
const LOCALE = arg("--locale")! as LocaleCode;
const OUT = path.join("shared/l10n", LOCALE);

const readJson = (f: string, d: any) => (fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, "utf8")) : d);
const segs: Segment[] = fs.readFileSync(path.join(dir, "segments.jsonl"), "utf8").trim().split("\n").map((l) => JSON.parse(l));
const final: Record<string, string> = readJson(path.join(dir, arg("--final", "final.json")!), null);
if (!final) throw new Error(`no ${arg("--final", "final.json")} in ${dir}`);

const missing = segs.filter((s) => typeof final[s.id] !== "string" || !final[s.id].trim());
if (missing.length) {
  console.error(`✗ ${missing.length} segment(s) have no final text, nothing written:\n  ${missing.slice(0, 10).map((s) => s.id).join("\n  ")}`);
  process.exit(1);
}

fs.mkdirSync(OUT, { recursive: true });
const load = async (f: string, name: string) => (fs.existsSync(path.join(OUT, f)) ? structuredClone((await import(path.resolve(OUT, f)))[name]) : {});
const catalog: Record<string, string> = await load("catalog.ts", "CATALOG");
const data: Record<string, any> = await load("data.ts", "DATA");
const jsx: Record<string, string> = await load("jsx.ts", "JSX_TEXT");
const meta: Record<string, string> = readJson(path.join(OUT, "meta.json"), {});

function setPath(root: Record<string, any>, p: (string | number)[], v: string) {
  let o = root;
  for (const k of p.slice(0, -1)) o = o[String(k)] ??= {};
  o[String(p[p.length - 1])] = v;
}

let n = { catalog: 0, data: 0, jsx: 0 };
for (const s of segs) {
  const text = applyLocaleTypography(final[s.id], LOCALE);
  if (s.source === "catalog") { catalog[s.en] = text; n.catalog++; }
  else if (s.source === "data") { setPath((data[s.twin!] ??= {}), s.path!, text); n.data++; }
  else if (s.id.startsWith("jsx:")) { jsx[s.id.slice(4)] = text; n.jsx++; }
  else if (s.source === "legal") continue; // legal pages are assembled by hand (localizedPage)
  meta[s.id] = s.srcHash;
}

const sorted = (o: Record<string, unknown>) => Object.fromEntries(Object.entries(o).sort(([a], [b]) => a.localeCompare(b)));
const HEAD = `// Generated by scripts/l10n/assemble.mts from a funnel-localize run. Do not edit by hand:\n// fix the run's final.json and assemble again.\n`;
const tsFile = (name: string, type: string, v: unknown) => `${HEAD}export const ${name}: ${type} = ${JSON.stringify(v, null, 1)};\n`;
fs.writeFileSync(path.join(OUT, "catalog.ts"), tsFile("CATALOG", "Readonly<Record<string, string>>", sorted(catalog)));
fs.writeFileSync(path.join(OUT, "data.ts"), tsFile("DATA", "Readonly<Record<string, unknown>>", data));
fs.writeFileSync(path.join(OUT, "jsx.ts"), tsFile("JSX_TEXT", "Readonly<Record<string, string>>", sorted(jsx)));
fs.writeFileSync(path.join(OUT, "meta.json"), JSON.stringify(sorted(meta), null, 1) + "\n");
console.log(`${OUT}: +${n.catalog} catalog, +${n.data} data leaves, +${n.jsx} jsx · now ${Object.keys(catalog).length} catalog keys, ${Object.keys(data).length} twins, ${Object.keys(meta).length} segments`);
