# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret (change in production)
JWT_SECRET=your-secret-key-here-change-in-production

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CREDITS_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_15MIN=price_...
STRIPE_PRICE_ID_30MIN=price_...

# Anthropic API Key (primary)
ANTHROPIC_API_KEY=sk-ant-...

# Optional Anthropic backup keys — used only if the primary returns a retryable
# error (429 rate limit, 529 overloaded, 401/403 revoked, 5xx). Traffic rotates
# automatically and recovers back to primary after a 60s cooldown. Omit these
# vars to disable failover (primary-only mode).
ANTHROPIC_API_KEY_BACKUP_1=
ANTHROPIC_API_KEY_BACKUP_2=

# Comma-separated list of addresses that receive failover/recovery email alerts.
# Leave unset to use the built-in default list.
ANTHROPIC_FAILOVER_ALERT_EMAILS=

# Model Configuration (cost optimization)
# Options: default, economy, high-quality
# - default: Haiku for greetings/summaries, Sonnet for conversation (15% savings, recommended)
# - economy: Haiku for everything (90% savings, use for testing/dev)
# - high-quality: Sonnet for everything (matches System 1, most consistent)
MODEL_MODE=default

# Resend API (for follow-up emails)
RESEND_API_KEY=re_...

# Follow-Up Email Configuration
FOLLOW_UP_FROM_EMAIL=hi@theseerwithin.com
FOLLOW_UP_FROM_NAME=The Seer Within
CRON_TIMEZONE=America/New_York

# Application Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# AWeber Configuration (optional)
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
AWEBER_ACCOUNT_ID=442730
AWEBER_LIST_ID=6936953
AWEBER_PAID_LIST_ID=6936955

# Kit (ConvertKit) Configuration (optional) — V1 leads are written here
# alongside AWeber. v4 API: single key, no secret. Funnel tags (v1/fb/fb2/gdn/
# palm) must be created in the Kit dashboard. No-ops when unset.
KIT_API_KEY=
KIT_FORM_ID=

# PayPal (System 2 credits — primary payment method)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # 'sandbox' or 'live'
VITE_PAYPAL_CLIENT_ID=        # same client ID, exposed to frontend

# Facebook Pixel (optional)
FB_PIXEL_ID=446814716830295

# Google Ads server-side conversions (optional)
# Stape sGTM Data Client endpoint (e.g. https://metrics.theseerwithin.com/data).
# When set, the server fires durable Google Ads conversions (Lead, IC, Purchase,
# Upsell1, Upsell2) via the sGTM container. Conversion ID + Labels are configured
# in the GTM tag, not here. Leave unset to ship dark.
SGTM_GADS_ENDPOINT=

# sGTM Preview token (debug only). When set, every server-fired GAds conversion
# carries `X-Gtm-Server-Preview: <token>` so events surface in the sGTM Preview
# pane — the Google Ads equivalent of FB Events Manager → Test Events. Get the
# value from sGTM Preview → ⋮ menu → "Send requests manually". UNSET after
# debugging so production events stop hitting the Preview session.
SGTM_PREVIEW_TOKEN=

# Sentry Error Monitoring (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
