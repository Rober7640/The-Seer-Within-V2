# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret (change in production)
JWT_SECRET=your-secret-key-here-change-in-production

# Stripe Configuration — Account A (primary / currently live)
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_TRACKDESK_WEBHOOK_SECRET=whsec_...   # /api/webhooks/stripe (V1 funnel + upsells)
STRIPE_CREDITS_WEBHOOK_SECRET=whsec_...      # /api/credits/webhook (V2 coin packs)
STRIPE_PRICE_ID_15MIN=price_...
STRIPE_PRICE_ID_30MIN=price_...

# Backup Stripe account (cold standby). Which account is live: A (default) or B.
# Switch day = set this to B AND swap VITE_STRIPE_PUBLISHABLE_KEY to B's key, then
# redeploy. All server-side charges follow ACTIVE_STRIPE_ACCOUNT automatically.
ACTIVE_STRIPE_ACCOUNT=A
# Account B keys — keep set but dormant while ACTIVE_STRIPE_ACCOUNT=A. Webhook
# verification accepts BOTH accounts' secrets, so leaving these set is harmless.
STRIPE_SECRET_KEY_B=sk_test_...
STRIPE_TRACKDESK_WEBHOOK_SECRET_B=whsec_...
STRIPE_CREDITS_WEBHOOK_SECRET_B=whsec_...

# Smoke alarm (Phase 3): when a real charge fails with an ACCOUNT-LEVEL error
# (account restricted/terminated, not a card decline), the app logs at ERROR and,
# if configured, emails/webhooks an alert (throttled 15 min). Both optional —
# without them the alarm is log-only (grep "[STRIPE-ACCOUNT-ALARM]").
STRIPE_ALERT_EMAIL_TO=                # comma-separated recipients
STRIPE_ALERT_WEBHOOK_URL=            # optional Slack/generic incoming webhook

# Anthropic API Key (primary)
ANTHROPIC_API_KEY=sk-ant-...

# Optional Anthropic backup keys — used only if the primary returns a retryable
# error (429 rate limit, 529 overloaded, 401/403 revoked, 5xx). Traffic rotates
# automatically and recovers back to primary after a 60s cooldown. Omit these
# vars to disable failover (primary-only mode).
ANTHROPIC_API_KEY_BACKUP_1=
ANTHROPIC_API_KEY_BACKUP_2=

# Comma-separated list of addresses that receive failover/recovery email alerts.
# Leave unset to use the built-in default list.
ANTHROPIC_FAILOVER_ALERT_EMAILS=

# Model Configuration (cost optimization)
# Options: default, economy, high-quality
# - default: Haiku for greetings/summaries, Sonnet for conversation (15% savings, recommended)
# - economy: Haiku for everything (90% savings, use for testing/dev)
# - high-quality: Sonnet for everything (matches System 1, most consistent)
MODEL_MODE=default

# Resend API (for follow-up emails)
RESEND_API_KEY=re_...

# Optional Resend Audience for per-lander segmentation. When set, each lead is
# added as a Contact to this audience with a `lander` property (homepage/fb/
# fb2/gdn/fb-palm/soulmate) for Segments + Broadcasts. Define a `lander` (string)
# Contact Property in Resend first. No-ops when unset; does NOT affect the
# transactional drip emails.
RESEND_AUDIENCE_ID=

# Optional per-lander Resend Segment IDs. When set, each lead is also added to
# its lander's segment so the team can send a Broadcast targeted at one lander.
# Create one segment per lander in Resend and paste its id here. Each is
# independent: an unset var means that lander silently skips the segment step
# (behavior identical to before). Non-blocking; does NOT affect drip emails.
RESEND_SEGMENT_ID_HOMEPAGE=
RESEND_SEGMENT_ID_FB=
RESEND_SEGMENT_ID_FB2=
RESEND_SEGMENT_ID_GDN=
RESEND_SEGMENT_ID_FB_PALM=
RESEND_SEGMENT_ID_SOULMATE=

# Follow-Up Email Configuration
FOLLOW_UP_FROM_EMAIL=hi@theseerwithin.com
FOLLOW_UP_FROM_NAME=The Seer Within
CRON_TIMEZONE=America/New_York

# Application Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# QA only: honour the `?paywallVariant=A|B` override on a production-build service
# (e.g. Railway dev) so QA can preview both paywall variants WITHOUT starting the
# experiment. Leave UNSET in production. Non-prod always honours the override.
# ALLOW_PAYWALL_QA_OVERRIDE=true

# DEV/QA ONLY: comma-separated experiment keys to run the REAL A/B split for while
# their DB status is still `draft` — WITHOUT flipping the shared-DB status column.
# Lets the dev deployment exercise real bucketing + exposure logging (log in as a
# few users → some get A, some B, no URL params) while production, which never sets
# this var, keeps the experiment draft and byte-identical (control arm, no exposures).
# ⚠️ MUST be UNSET in production — setting it there would enrol real users. Unset the
# var again after verifying. See server/lib/experiments.ts shouldForceRunning().
# EXPERIMENT_FORCE_RUNNING=paywall_copy_2026

# DEV/QA ONLY: replaces the system_config `v1_price_variants` pool for THIS process.
# Same problem as EXPERIMENT_FORCE_RUNNING, for V1 prices: dev and production SHARE
# ONE DATABASE, so editing that config row to start a price test is INSTANTLY live to
# real traffic (~620 fb-palm conversations/day) and can never be rehearsed first. That
# is how a corrupted price key silently killed the root $45 test for two weeks.
#
# Set this on the Railway DEV service (or locally) to serve the exact pool you intend
# to ship, while production's config row — and production traffic — stay untouched.
# Verify on dev → deploy the code → THEN run improve-v1/go-live-55-35-config.sql.
#
# ⚠️ MUST be UNSET in production. It is logged loudly at every pool refresh, and
# /admin/price-test reports `variantsSource: "env"` whenever it is active — production
# must always read "db". A malformed value serves the $35/$25 fallback and does NOT
# silently fall back to the shared DB pool.
#
# Example — the thumb-only 50/50 sliding close (see the go-live SQL for the full pool):
# V1_PRICE_VARIANTS_JSON={"variants":[{"id":"35_palm_u47","funnel":"v1-palm","weight":1,"priceCents":3500,"downsellCents":2500,"upsell1Cents":4700},{"id":"55-35_palm","funnel":"v1-palm","weight":1,"priceCents":5500,"downsellCents":3500,"upsell1Cents":4700,"signs":["thumb"]}]}

# AWeber Configuration (optional)
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
AWEBER_ACCOUNT_ID=442730
AWEBER_LIST_ID=6936953
AWEBER_PAID_LIST_ID=6936955

# Optional per-lander FREE/lead lists. When a funnel's list ID is set, that
# lander's leads go to its own AWeber list; otherwise they fall back to
# AWEBER_LIST_ID (homepage always uses AWEBER_LIST_ID). Paid lists are shared
# and segmented by the existing seer-within-upsell-<funnel> tags. Leave unset
# to keep current behavior (all leads on AWEBER_LIST_ID).
#
# BEFORE setting one of these to a NEW list, create the `resume_url` custom
# field on that list — custom fields are per-list, not per-account, and lead
# capture writes resume_url on every funnel. Without it AWeber rejects the
# whole write; addSubscriberToList then retries without custom fields so the
# lead still lands, but that funnel silently gets no recovery links.
# Also note a new list does NOT inherit the campaigns/automations running on
# AWEBER_LIST_ID — those have to be recreated on it.
AWEBER_LIST_ID_FB=
AWEBER_LIST_ID_FB2=
AWEBER_LIST_ID_GDN=
AWEBER_LIST_ID_PALM=
AWEBER_LIST_ID_TAROT=
# The eleven /fb-tarot MONEY-BLOCK landers only (bucket 'money' on v1-tarot).
# Takes precedence over AWEBER_LIST_ID_TAROT for those leads; every other tarot
# lander is unaffected. Unset => exact current behaviour, so the code can ship
# dark and the cutover is a separate, reversible step.
# 6971693 = "theseerwithin_free_tarot_money" (resume_url custom field created).
AWEBER_LIST_ID_TAROT_MONEY=

# The BACKEND DECK's customer list (`theseerwithin_be_customer`) — one list for
# every backend offer (02 Twin Flame, 03 Judgement Day, …), segmented by the
# be-<nn>-<slug> tags in server/lib/backendCustomerList.ts. An AWeber Campaign
# triggered by each offer's tag is what sends that buyer her thank-you, so this
# is a SENDING dependency, not just a list. Unset = no thank-you goes out.
# ⛔ Not AWEBER_PAID_LIST_ID — that one is V1's $35 buyers.
# Create the list and its four custom fields by hand first: see Phase C0 of
# improve-v1/v1-one-time-BEs/docs/0-WORKFLOW.md
AWEBER_BE_CUSTOMER_LIST_ID=

# Kit (ConvertKit) Configuration (optional) — V1 leads are written here
# alongside AWeber. v4 API: single key, no secret. Funnel tags (v1/fb/fb2/gdn/
# palm) must be created in the Kit dashboard. No-ops when unset.
KIT_API_KEY=
KIT_FORM_ID=
# Optional: dedicated Kit form for /soulmate leads (tagged "soulmate"). When
# unset, soulmate leads use KIT_FORM_ID. Set on the soulmate Railway service.
KIT_SOULMATE_FORM_ID=

# PayPal (System 2 credits — primary payment method)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # 'sandbox' or 'live'
VITE_PAYPAL_CLIENT_ID=        # same client ID, exposed to frontend

# Facebook Pixel (optional)
FB_PIXEL_ID=446814716830295

# Google Ads server-side conversions (optional)
# Stape sGTM Data Client endpoint (e.g. https://metrics.theseerwithin.com/data).
# When set, the server fires durable Google Ads conversions (Lead, IC, Purchase,
# Upsell1, Upsell2) via the sGTM container. Conversion ID + Labels are configured
# in the GTM tag, not here. Leave unset to ship dark.
SGTM_GADS_ENDPOINT=

# sGTM Preview token (debug only). When set, every server-fired GAds conversion
# carries `X-Gtm-Server-Preview: <token>` so events surface in the sGTM Preview
# pane — the Google Ads equivalent of FB Events Manager → Test Events. Get the
# value from sGTM Preview → ⋮ menu → "Send requests manually". UNSET after
# debugging so production events stop hitting the Preview session.
SGTM_PREVIEW_TOKEN=

# Sentry Error Monitoring (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Kit / ConvertKit (email platform)
# V4 API key from Kit → Account Settings → Developer. Sent as the X-Kit-Api-Key
# header. 120 req/60s limit; bulk + purchase endpoints require OAuth instead.
KIT_API_KEY=

# AWS S3 — hosting for Luna daily-email assets (per-day sky maps, avatars)
# Public-read bucket; images are referenced by permanent absolute URL in emails.
# Used by scripts/build-luna-batch.ts via server/lib/s3Upload.ts. Leave unset to
# fall back to hosting PNGs on theseerwithin.com.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=luna-assets                 # dotless name (TLS cert breaks on dots)
ASSET_BASE_URL=https://luna-assets.s3.us-east-1.amazonaws.com  # no trailing slash

# Registration anti-fraud thresholds (all optional; sensible defaults in code).
# Tunable on Railway WITHOUT a redeploy. The IP check is a coarse backstop — the
# real gates are Turnstile + disposable/NeverBounce email + email verification —
# so it is tuned to NOT block real buyers, who share IPs via mobile CGNAT/offices/cafés.
#   MAX_ACCOUNTS_PER_IP_24H          — accounts/IP/24h that FLAG for admin review (does NOT block). Default 10.
#   HARD_BLOCK_ACCOUNTS_PER_IP_24H   — accounts/IP/24h that are REFUSED (extreme, script-like volume). Default 25.
#   MAX_ACCOUNTS_PER_FINGERPRINT_24H — accounts/device-fingerprint/24h that FLAG (stronger signal, not CGNAT-affected). Default 3.
MAX_ACCOUNTS_PER_IP_24H=10
HARD_BLOCK_ACCOUNTS_PER_IP_24H=25
MAX_ACCOUNTS_PER_FINGERPRINT_24H=3
