node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# reframe-deck render output (regenerable from sends/<cycle>/*.md via scripts/render-aweber.mjs)
docs/aweber/evelyn-reframe-deck/sends/*/_build/

# Environment variables
.env
.env.local
.env.*.local
# .env backups (AWeber broadcast token rotation writes .env.bak-<timestamp>; holds live secrets)
.env.bak*
# Generated by scripts/make-sandbox-env.mjs — carries a Stripe test key + API keys.
.env.sandbox
.env.test

# Local config files that may contain credentials
.mcp.json
.claude/settings.local.json

# IDE / AI tool directories
.cursor/
.agent/
.agents/
.superpowers/

# Runtime directories
logs/
playwright-report/
test-results/
scripts/audit/
audit-runs/

# Windows artifacts
nul

# Debug / one-off scripts (not part of the product)
check-credits.js
check-memory.cjs
check_credits.js
fix-sessions.cjs
get-admin-token.cjs
test-api.js

# Pre-session design mockups (not production code)
pre-session-backup.html
pre-session-correct-design.html
pre-session-final.html
pre-session-improved.tsx
pre-session-ux-improvements.html
wireframes-pre-session.html

# Duplicate avatar at repo root (real one is in client/public/)
evelyn-avatar.png

# Reference files
attached/
# Playwright UI-capture screenshots (transcripts are committed; images are not)
improve-v2/eval/ui-runs/*/shots/

# Data exports — real customer PII (name/email) + user-deletion backups.
# NOTE: exports/conversations_export.csv predates this rule and stays tracked;
# .gitignore does not untrack files that are already committed.
exports/

# DB/Railway log dumps — carry password_hash, reset/verification tokens,
# magic-link tokens. The `logs/` dir is ignored above; this is the loose file form.
logs.*.json

# Meeting recordings + transcripts dropped at the repo root. Root-anchored on
# purpose: client/public/**/*.mp4 and evelyncross-soulmate/**/*.mp4 are product
# assets and must stay tracked.
/*.mp4
/*.docx

# Throwaway one-off debug scripts at the repo root (_arm.mjs, _prodcheck.mjs, …)
/_*.mjs

# Pre-migration DB snapshots (dollar-wallet cutover). Carry live wallet balances
# keyed by user id; the full-table dumps also carry persona prompts. Never commit.
DB_Backup/
server-sandbox.log

# Backend deck — the ASSEMBLED product. Regenerated from the copy specs by
# scripts/build-be-product.mjs, so committing it would put a 2MB binary in every
# diff for words that already live in copy/<nn>/ as text.
# ⚠ assets/be-reference.docx is NOT ignored, and must not be: it is the page design
# for the whole deck, hand-adjusted in Word, and regenerating it discards that work.
improve-v1/v1-one-time-BEs/build/

# One-off operational scripts and their data, under scripts/. These carry REAL
# subscriber data — _unsubscribe-run2-ids.json alone holds ~47,000 AWeber
# subscriber ids — and they are working files, not source. Ignored by prefix so a
# stray `git add -A` cannot put them in the history, where they cannot be recalled.
scripts/_*

# Local n8n study folder — workflow JSON exports live here and are NEVER pushed
# (Joel's own working copies; also carry webhook URLs / node credentials refs).
# Any n8n workflow JSON we build goes in here, not anywhere else in the repo.
n8n-workflows/
